<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pabilo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pabilo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 17 sustituyó el div.settings por las etiquetas app/block/setting.
                 base.res_config_settings_view_form es un <form/> vacío, así que se
                 inyecta dentro de //form. -->
            <xpath expr="//form" position="inside">
                <app data-string="Pabilo" string="Pabilo" name="pabilo_payment_gateway"
                     groups="base.group_system">
                    <block title="Conexión con Pabilo" id="pabilo_api_section">
                        <setting string="API Key (appKey)"
                                 help="Llave de tu cuenta de Pabilo. Se usa para verificar los pagos.">
                            <field name="pabilo_api_key" widget="password"/>
                        </setting>
                        <setting string="URL Base"
                                 help="Backend de Pabilo. Local con Odoo en Docker: http://host.docker.internal:3349">
                            <field name="pabilo_api_url"/>
                        </setting>
                        <setting string="Secreto del Webhook"
                                 help="Se obtiene solo de Pabilo al sincronizar; es propio de tu cuenta. Sin él, los webhooks de enlaces de pago se rechazan.">
                            <field name="pabilo_webhook_secret" widget="password"/>
                        </setting>
                        <setting string="Cuentas bancarias"
                                 help="Trae desde Pabilo las cuentas donde se verificarán los pagos. Son de solo lectura en Odoo.">
                            <button name="action_pabilo_sync_banks" type="object"
                                    string="Sincronizar Cuentas Pabilo"
                                    class="btn-secondary" icon="fa-refresh"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pabilo_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes Pabilo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'pabilo_payment_gateway', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_pabilo_root"
              name="Pabilo"
              sequence="100"
              web_icon="pabilo_payment_gateway,static/description/icon.png"/>

    <menuitem id="menu_pabilo_config"
              name="Configuración"
              parent="menu_pabilo_root"
              sequence="10"
              groups="base.group_system"/>

    <menuitem id="menu_pabilo_config_settings"
              name="Ajustes Pabilo"
              parent="menu_pabilo_config"
              sequence="10"
              groups="base.group_system"
              action="action_pabilo_config_settings"/>
</odoo>
