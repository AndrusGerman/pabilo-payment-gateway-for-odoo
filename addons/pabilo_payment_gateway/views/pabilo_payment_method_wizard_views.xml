<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pabilo_payment_method_wizard_view_form" model="ir.ui.view">
        <field name="name">pabilo.payment.method.wizard.form</field>
        <field name="model">pabilo.payment.method.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar Método de Pago Pabilo">
                <p class="text-muted">
                    Crea un método de pago del Punto de Venta que verifica pagos
                    a través de Pabilo: pago móvil, transferencias y Binance.
                </p>
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="name"/>
                    <field name="pabilo_user_bank_id" options="{'no_create': True}"/>
                    <field name="journal_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Crear Método de Pago" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pabilo_payment_method_wizard" model="ir.actions.act_window">
        <field name="name">Agregar Método de Pago Pabilo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pabilo.payment.method.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="pos_payment_method_view_tree_inherit_pabilo" model="ir.ui.view">
        <field name="name">pos.payment.method.tree.inherit.pabilo</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="%(action_pabilo_payment_method_wizard)d"
                            type="action"
                            string="Agregar Método Pabilo"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
