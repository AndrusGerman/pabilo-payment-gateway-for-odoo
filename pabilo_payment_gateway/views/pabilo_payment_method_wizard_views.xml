<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pabilo_payment_method_wizard_view_form" model="ir.ui.view">
        <field name="name">pabilo.payment.method.wizard.form</field>
        <field name="model">pabilo.payment.method.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar Método de Pago Pabilo">
                <p class="text-muted">
                    Crea un método de pago del Punto de Venta que verifica pagos
                    a través de Pabilo: pago móvil, transferencias y Binance.
                </p>
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="name"/>
                    <field name="pabilo_user_bank_id" options="{'no_create': True}"/>
                    <field name="journal_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Crear Método de Pago" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pabilo_payment_method_wizard" model="ir.actions.act_window">
        <field name="name">Agregar Método de Pago Pabilo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pabilo.payment.method.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Odoo 16 no puede mostrar un botón de <header> en una lista salvo que
         haya filas seleccionadas: el template lo envuelve en t-if="nbSelected"
         (web/views/list/list_controller.xml:54) y no existe el display="always"
         que sí trae la 17. Un botón que crea un registro nuevo no tiene nada
         que seleccionar, así que aquí el acceso es únicamente por el menú. -->
    <menuitem id="menu_pabilo_payment_method"
              name="Agregar Método de Pago Pabilo"
              parent="menu_pabilo_root"
              sequence="7"
              groups="point_of_sale.group_pos_manager"
              action="action_pabilo_payment_method_wizard"/>
</odoo>
