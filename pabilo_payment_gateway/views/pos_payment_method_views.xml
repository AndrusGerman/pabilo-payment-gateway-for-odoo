<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pabilo" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pabilo</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="pabilo_user_bank_id"
                       invisible="use_payment_terminal != 'pabilo'"
                       required="use_payment_terminal == 'pabilo'"
                       options="{'no_create': True}"
                       string="Cuenta Bancaria Pabilo"/>
                <field name="pabilo_amount_confirm"
                       invisible="use_payment_terminal != 'pabilo'"/>
                <field name="pabilo_alt_rate_field"
                       invisible="use_payment_terminal != 'pabilo'"
                       placeholder="p. ej. tasa_bcv (vacío = tasa de Odoo)"/>
            </xpath>
        </field>
    </record>
</odoo>
