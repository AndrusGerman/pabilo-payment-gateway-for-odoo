<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pabilo_user_bank_view_tree" model="ir.ui.view">
        <field name="name">pabilo.user.bank.tree</field>
        <field name="model">pabilo.user.bank</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="display_name"/>
                <field name="provider"/>
                <field name="account_number"/>
                <field name="currency_id"/>
                <field name="supports_payment_link"/>
                <field name="is_trashed"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="pabilo_user_bank_view_form" model="ir.ui.view">
        <field name="name">pabilo.user.bank.form</field>
        <field name="model">pabilo.user.bank</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Estas cuentas son un espejo de solo lectura de Pabilo.
                        Para modificarlas, edítalas en Pabilo y luego pulsa
                        <b>Ajustes → Pabilo → Sincronizar Cuentas</b>.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pabilo_id"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="account_number"/>
                            <field name="account_type"/>
                            <field name="currency_id"/>
                            <field name="supports_payment_link"/>
                            <field name="is_trashed"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pabilo_user_bank" model="ir.actions.act_window">
        <field name="name">Cuentas Pabilo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pabilo.user.bank</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay cuentas sincronizadas</p>
            <p>
                Las cuentas bancarias se administran en Pabilo y aquí solo se consultan.
                Configura tu API Key en <b>Ajustes → Pabilo</b> y pulsa
                <b>Sincronizar Cuentas</b>.
            </p>
        </field>
    </record>

    <menuitem id="menu_pabilo_user_bank"
              name="Cuentas Bancarias"
              parent="menu_pabilo_root"
              sequence="5"
              action="action_pabilo_user_bank"/>
</odoo>
